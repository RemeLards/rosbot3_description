<?xml version="1.0" encoding="utf-8"?>

<!--
  Description of the RosBot3 robot.

  Author: Helio Perroni Filho
-->

<robot name="rosbot3" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find rosbot3_description)/urdf/ugv02.xacro"/>

  <xacro:property name="overall_height_with_lidar" value="${141.0 * M}"/>
  <xacro:property name="overall_height_with_camera" value="${197.0 * M}"/>
  <!-- 
    RosBot3 Lidar (Rosbot3 Pro Lidar is different)
    https://www.slamtec.com/en/C1/Spec
  -->
  <xacro:property name="lidar_side" value="${55.6 * M}"/>
  <xacro:property name="lidar_total_height" value="${overall_height_with_lidar - overall_height}"/>
  <xacro:property name="lidar_base_height" value="${lidar_total_height * 0.3}"/>
  <xacro:property name="lidar_height" value="${lidar_total_height * 0.7}"/>
  <xacro:property name="lidar_radius" value="${lidar_side * 0.4}"/>

  <!-- 
    Rosbot3 Camera (Rosbot3 Pro Camera is different)
    https://shop.luxonis.com/products/oak-d-lite-1?variant=42583102456031
  -->
  
  <xacro:property name="camera_length" value="${91.0 * M}"/>
  <xacro:property name="camera_heigth" value="${28.0 * M}"/>
  <xacro:property name="camera_thickness" value="${17.5 * M}"/>

  <xacro:property name="camera_square_base_side" value="${5.0 * M}"/>
  <xacro:property name="camera_square_base_thickness" value="${1.0 * M}"/>
  <!--
    Value calculated considering heigths with and without camera and a 45° angle starting from the base 
    Calculus -> (overall_height_with_camera-overall_height-camera_height*0.5 - camera_square_base_thickness)/ (sine(45°))

  -->
  <xacro:property name="camera_square_stem_length" value="${(overall_height_with_camera - overall_height - camera_heigth * 0.2 - camera_square_base_thickness ) * (sqrt(2)/2.0) }"/>

  <!-- 
    Rosbot3 Camera (Rosbot3 Pro Camera is different)
    https://shop.luxonis.com/products/oak-d-lite-1?variant=42583102456031

    Need to fix camera front, its no accurate
  
  -->

  <xacro:macro
    name="camera_base"
  >
    <xacro:solid_block
      name="camera_left_square_base"
      size_x="${camera_square_base_side}"
      size_y="${camera_square_base_side}"
      size_z="${camera_square_base_thickness}"
      yaw="${45 * DEG}"
    />

    <xacro:solid_block
      name="camera_left_stem"
      size_x="${camera_square_base_side * 0.5}"
      size_y="${camera_square_base_side * 0.5}"
      size_z="${camera_square_stem_length}"
      pitch="${45 * DEG}" 
    />

    <xacro:joint_fixed
      parent="camera_left_square_base"
      child="camera_left_stem"
      z="${(camera_square_base_thickness + camera_square_stem_length * sqrt(2) * 0.5) * 0.5}"
      x="${(camera_square_stem_length * sqrt(2) * 0.5) * 0.5}"
    />

    <!-- <xacro:solid_cylinder
      name="wheel_${position}_right"
      length="${wheel_thickness}"
      radius="${wheel_radius}"
      roll="${90.0 * DEG}"
    />

    <xacro:solid_cylinder
      name="wheel_${position}_axle"
      length="${body_width}"
      radius="0.005"
      roll="${90.0 * DEG}"
    />

    <xacro:joint_continuous
      name="joint_wheel_${position}_left"
      parent="wheel_${position}_axle"
      child="wheel_${position}_left"
      y="${(body_width + wheel_thickness) * 0.5}"
      axis="0 1 0"
    />

    <xacro:joint_continuous
      name="joint_wheel_${position}_right"
      parent="wheel_${position}_axle"
      child="wheel_${position}_right"
      y="${(body_width + wheel_thickness) * -0.5}"
      axis="0 1 0"
    /> -->
  </xacro:macro>

  <!-- <xacro:camera_base/>

  <xacro:joint_fixed
    parent="fenders_top"
    child="camera_left_square_base"
    x="${-lidar_side*0.5 - camera_square_stem_length* (1/math.sqrt(2)) }"
    y="${-lidar_side * 0.5}"
    z="${(fender_thickness + camera_square_base_thickness) * 0.5}"
  /> -->

  <link name="camera_front"/>
  <xacro:joint_fixed
    parent="fenders_top"
    child="camera_front"
    x="${0.5 * fender_thickness}"
  />

  <!-- 
    RosBot3 Lidar (Rosbot3 Pro Lidar is different)
    https://www.slamtec.com/en/C1/Spec

    Lidar cilinder shape is arbitrary, since Slamtec only gives a 'box-like' shape dimensions
    It only needs to respect the max lidar height (lidar_base_height + lidar_height = max_height),
    and the radius need to be less than 'lidar_side'
    The 'lidar_base' height needs to be less than the laser link height
  -->
  <xacro:solid_block
    name="lidar_base"
    size_x="${lidar_side}"
    size_y="${lidar_side}"
    size_z="${lidar_base_height}"
  />

  <xacro:joint_fixed
    parent="fenders_top"
    child="lidar_base"
    z="${(fender_thickness + lidar_base_height) * 0.5}"
  />

  <xacro:solid_cylinder
    name="lidar"
    length="${lidar_height}"
    radius="${lidar_side * 0.4}"
  />

  <xacro:joint_fixed
    parent="lidar_base"
    child="lidar"
    z="${(lidar_height + lidar_base_height) * 0.5}"
  />

  <link name="laser"/>
  <xacro:joint_fixed
    parent="lidar_base"
    child="laser"
    z="${lidar_base_height + lidar_height * 0.5}"
  />
</robot>
