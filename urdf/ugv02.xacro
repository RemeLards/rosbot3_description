<?xml version="1.0" encoding="utf-8"?>

<!--
  Description of the RosBot3 body mobile base.

  Author: Rafael Fracalossi Freitas
-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find ros_commons)/urdf/domain.xacro"/>

  <!-- Scale -->
  <xacro:property name="M" value="0.001"/>

  <!-- Overall properties -->
  <xacro:property name="ground_clearance" value="${23.0 * M}"/>
  <xacro:property name="overall_height" value="${103.0 * M}"/>

  <!-- Body properties -->
  <xacro:property name="body_length" value="${200 * M}"/>
  <xacro:property name="body_width" value="${233 * M - 2 * wheel_thickness}"/>
  <xacro:property name="body_height" value="${overall_height - ground_clearance}"/>

  <!-- Wheel properties -->
  <xacro:property name="wheel_diameter" value="${84 * M}"/>
  <xacro:property name="wheelbase" value="${106 * M}"/>
  <xacro:property name="wheel_radius" value="${0.5 * wheel_diameter}"/>
  <!--
    Defining arbitrary wheel thickness, since this information is not given 
  -->
  <xacro:property name="wheel_thickness" value="${50.0 * M}"/>
  <xacro:property name="wheel_axle_z_offset" value="${wheel_radius - 0.5 * body_height - ground_clearance}"/>

  <!-- Fender properties -->
  <xacro:property name="fender_height" value="${1.0 * M}"/>
  <xacro:property name="fender_length" value="${214.04 * M}"/>
  <!--
    A thin fender layer, to mimic the robot construction
  -->
  <xacro:property name="fender_thickness" value="${1.0 * M}"/>
  <!--
    The width of the fender should not cover the entire wheel, but only half of it
  -->
  <xacro:property name="fender_top_width" value="${body_width + wheel_thickness}"/>


  <xacro:macro
    name="wheels"
    params="position"
  >
    <xacro:solid_cylinder
      name="wheel_${position}_left"
      length="${wheel_thickness}"
      radius="${wheel_radius}"
      roll="${90.0 * DEG}"
    />

    <xacro:solid_cylinder
      name="wheel_${position}_right"
      length="${wheel_thickness}"
      radius="${wheel_radius}"
      roll="${90.0 * DEG}"
    />

    <xacro:solid_cylinder
      name="wheel_${position}_axle"
      length="${body_width}"
      radius="0.005"
      roll="${90.0 * DEG}"
    />

    <xacro:joint_continuous
      name="joint_wheel_${position}_left"
      parent="wheel_${position}_axle"
      child="wheel_${position}_left"
      y="${(body_width + wheel_thickness) * 0.5}"
      axis="0 1 0"
    />

    <xacro:joint_continuous
      name="joint_wheel_${position}_right"
      parent="wheel_${position}_axle"
      child="wheel_${position}_right"
      y="${(body_width + wheel_thickness) * -0.5}"
      axis="0 1 0"
    />
  </xacro:macro>

  <xacro:wheels position="front"/>
  <xacro:wheels position="rear"/>

  <xacro:solid_block
    name="body"
    size_x="${body_length}"
    size_y="${body_width}"
    size_z="${body_height}"
  />

  <xacro:solid_block
    name="fenders_top"
    size_x="${fender_length}"
    size_y="${fender_top_width}"
    size_z="${fender_thickness}"
  />

  <xacro:joint_fixed
    parent="body"
    child="fenders_top"
    z="${0.5 * (body_height - fender_thickness)}"
  />

  <xacro:joint_fixed
    parent="body"
    child="wheel_front_axle"
    x="${0.5 * wheelbase}"
    z="${wheel_axle_z_offset}"
  />

  <xacro:joint_fixed
    parent="body"
    child="wheel_rear_axle"
    x="${-0.5 * wheelbase}"
    z="${wheel_axle_z_offset}"
  />

  <link name="base_link"/>
  <xacro:joint_fixed
    parent="base_link"
    child="body"
    z="${ground_clearance + 0.5 * body_height}"
  />
</robot>
